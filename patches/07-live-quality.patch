+    /// Switch stream quality without touching the display or the connection:
+    /// only capture and the encoder restart, at the new size and bitrate, and
+    /// the receiver resyncs on the keyframe that follows. Acknowledged with
+    /// `qualityChanged`, which tells the receiver this build can do it (older
+    /// ones go through standby instead).
+    private func changeQuality(to newQuality: StreamQuality) async {
+        guard !stopped, !reconfiguring, let display = captureDisplay, nativeCaptureSize.width > 0 else { return }
+        reconfiguring = true
+        defer { reconfiguring = false }
+        if newQuality != quality {
+            Log.info("quality \(quality.rawValue) → \(newQuality.rawValue)")
+            quality = newQuality
+            if let stream { try? await stream.stopCapture() }
+            stream = nil
+            if let encoder { VTCompressionSessionInvalidate(encoder) }
+            encoder = nil
+            needsKeyframe = true
+            let captureW = (Int(Double(nativeCaptureSize.width) * quality.scale)) & ~1
+            let captureH = (Int(Double(nativeCaptureSize.height) * quality.scale)) & ~1
+            do {
+                try await startCapture(display: display, pixelsWide: captureW, pixelsHigh: captureH)
+            } catch {
+                Log.info("quality change failed: \(error) — retrying")
+                queue.async { self.scheduleCaptureRecovery() }
+                return
+            }
+        }
+        queue.async { self.sendJSON(["type": "qualityChanged", "quality": newQuality.rawValue]) }
+    }
+
