+    /// Tells the receiver the moment the Mac locks or unlocks: capture
+    /// pauses on the lock screen, and the receiver explains the frozen
+    /// picture and offers to type the password.
+    private func observeLock() {
+        DispatchQueue.main.async { [weak self] in
+            guard let self, self.lockObservers.isEmpty, !self.stopped else { return }
+            let center = DistributedNotificationCenter.default()
+            for (name, locked) in [("com.apple.screenIsLocked", true), ("com.apple.screenIsUnlocked", false)] {
+                let observer = center.addObserver(forName: Notification.Name(name), object: nil,
+                                                  queue: nil) { [weak self] _ in
+                    guard let self else { return }
+                    Log.info("screen \(locked ? "locked" : "unlocked") — telling the receiver")
+                    self.queue.async { self.sendJSON(["type": "macLock", "locked": locked]) }
+                }
+                self.lockObservers.append(observer)
+            }
+        }
+    }
+
+    private static var screenIsLocked: Bool {
+        let session = CGSessionCopyCurrentDictionary() as? [String: Any]
+        return session?["CGSSessionScreenIsLocked"] as? Bool ?? false
+    }
