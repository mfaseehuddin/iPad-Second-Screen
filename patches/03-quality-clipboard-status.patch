+    // MARK: - Clipboard sync and Mac status (receiver subscriptions)
+
+    // Queue-confined.
+    private var clipboardSync = false
+    private var statusSubscribed = false
+    private var extrasStarted = false
+    private var lastClipboard: String?
+    private var clipboardChangeCount = -1
+
+    private func scheduleExtras(tick: Int = 0) {
+        queue.asyncAfter(deadline: .now() + 1) { [weak self] in
+            guard let self, !self.stopped else { return }
+            if self.clipboardSync { self.pollClipboard() }
+            if self.statusSubscribed, tick % 15 == 0 { self.sendMacStatus() }
+            self.scheduleExtras(tick: tick + 1)
+        }
+    }
+
+    /// Sends Mac clipboard text that changed since the last poll. What was
+    /// on the clipboard before sync started stays on the Mac.
+    private func pollClipboard() {
+        DispatchQueue.main.async { [weak self] in
+            let count = NSPasteboard.general.changeCount
+            let text = NSPasteboard.general.string(forType: .string)
+            self?.queue.async {
+                guard let self, count != self.clipboardChangeCount else { return }
+                let firstPoll = self.clipboardChangeCount == -1
+                self.clipboardChangeCount = count
+                // Receivers parse control messages under 32 KB.
+                guard !firstPoll, let text, text != self.lastClipboard, text.utf8.count <= 16_000 else { return }
+                self.lastClipboard = text
+                self.sendJSON(["type": "clipboard", "text": text])
+            }
+        }
+    }
+
+    /// Battery level and power source, for the receiver's status bar.
+    private func sendMacStatus() {
+        var message: [String: Any] = ["type": "macStatus"]
+        if let info = IOPSCopyPowerSourcesInfo()?.takeRetainedValue(),
+           let sources = IOPSCopyPowerSourcesList(info)?.takeRetainedValue() as? [CFTypeRef] {
+            for source in sources {
+                guard let description = IOPSGetPowerSourceDescription(info, source)?
+                        .takeUnretainedValue() as? [String: Any],
+                      description[kIOPSTypeKey] as? String == kIOPSInternalBatteryType else { continue }
+                if let current = description[kIOPSCurrentCapacityKey] as? Int,
+                   let maximum = description[kIOPSMaxCapacityKey] as? Int, maximum > 0 {
+                    message["battery"] = current * 100 / maximum
+                }
+                message["charging"] = description[kIOPSIsChargingKey] as? Bool ?? false
+                message["onAC"] = description[kIOPSPowerSourceStateKey] as? String == kIOPSACPowerValue
+            }
+        }
+        sendJSON(message)
+    }
+
+    private func sendJSON(_ object: [String: Any]) {
+        guard let data = try? JSONSerialization.data(withJSONObject: object),
+              let json = String(data: data, encoding: .utf8) else { return }
+        sendJSONFrame(json)
+    }
+
